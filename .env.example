# Openfront Hotel production configuration template.
# Replace every CHANGE_ME value; production intentionally rejects placeholders.

# Core
NODE_ENV=production
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@db.example.net:5432/openfront_hotel
SESSION_SECRET=CHANGE_ME_generate_at_least_32_random_characters
HOTEL_DATA_ENCRYPTION_KEY=CHANGE_ME_generate_at_least_32_random_characters
HOTEL_QUOTE_SECRET=CHANGE_ME_generate_at_least_32_random_characters
NEXT_PUBLIC_SITE_URL=https://hotel.example.com
NEXTAUTH_URL=https://hotel.example.com
TRUST_PROXY=off
# Set railway only inside a Railway environment.
# TRUST_PROXY=railway

# Worker identity/timing only. Workers start safely and inspect persisted
# provider/channel/property state; there are no environment capability flags.
HOTEL_REFUND_WORKER_ID=hotel-refund-primary
HOTEL_REFUND_INTERVAL_MS=5000

# Optional SMTP infrastructure. Delivery remains unconfigured until property
# settings exist; an incomplete tuple stays disabled without blocking startup.
SMTP_HOST=smtp.example.net
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=stay@hotel.example.com
PASSWORD_RESET_ORIGIN=https://hotel.example.com
RESET_ACTION_SECRET=CHANGE_ME_generate_at_least_32_random_characters

# Optional object-storage infrastructure. Uploads remain blocked until this
# tuple is complete and persisted property settings exist.
S3_BUCKET_NAME=openfront-hotel-assets
S3_REGION=us-east-1
S3_ENDPOINT=https://objects.example.net
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# Stripe and PayPal are configured after init in Dashboard → Payment providers.
# Enabled state and encrypted credentials are persisted in PaymentProvider; no
# provider credentials or capability booleans belong in Railway variables.

# Optional authenticated HTTP outbox infrastructure. A partial tuple fails
# closed; omitting all three keeps HTTP dispatch unconfigured.
HOTEL_OUTBOX_DISPATCH_URL=
HOTEL_OUTBOX_DISPATCH_SECRET=
HOTEL_OUTBOX_DISPATCH_CREDENTIAL_KEY_ID=
HOTEL_OUTBOX_WORKER_ID=hotel-outbox-primary
HOTEL_OUTBOX_INTERVAL_MS=5000
# Optional authenticated receiver endpoint at /api/hotel/outbox/receiver.
# Set both only when this deployment accepts HMAC-signed external events.
HOTEL_OUTBOX_RECEIVER_SECRET=
HOTEL_OUTBOX_RECEIVER_CREDENTIAL_KEY_ID=

# Channel enabled state, endpoints, webhook secret, and credentials are
# persisted in Channel records. This is worker identity only.
CHANNEL_SYNC_WORKER_ID=hotel-channel-primary

# Optional dashboard AI; never required for PMS operation.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MAX_TOKENS=4096

# Optional internal routing overrides. INTERNAL_APP_URL is the server-side
# origin; GRAPHQL_INTERNAL_URL may be either that origin or its /api/graphql URL.
INTERNAL_APP_URL=http://127.0.0.1:3000
GRAPHQL_INTERNAL_URL=http://127.0.0.1:3000/api/graphql
NEXT_PUBLIC_GRAPHQL_ENDPOINT=/api/graphql
PUBLIC_SIGNUPS_ALLOWED=false
