  bookedRooms  Int      @default(0)
  blockedRooms Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([date])
  @@index([roomTypeId])
}

model HousekeepingTask {
