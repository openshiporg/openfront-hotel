model ChannelSyncEvent {
  id            String    @id @default(cuid())
  channel       Channel   @relation("ChannelSyncEvent_channel", fields: [channelId], references: [id])
  channelId     String    @map("channel")
  action        String?   @default("webhook_event")
  status        String?   @default("success")
  replayKey     String?   @unique
  message       String    @default("")
  payload       Json?     @default("{}")
  errorMessage  String    @default("")
  attempts      Int?      @default(0)
  nextAttemptAt DateTime?
  occurredAt    DateTime? @default(now())
  createdBy     User?     @relation("ChannelSyncEvent_createdBy", fields: [createdById], references: [id])
  createdById   String?   @map("createdBy")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([channelId])
  @@index([createdById])
}

model DailyMetrics {
  id                      String   @id @default(cuid())
  date                    DateTime @unique
  totalRooms              Int      @default(0)
  occupiedRooms           Int      @default(0)
  occupancyRate           Float?   @default(0)
  averageDailyRate        Int?     @default(0)
  revenuePerAvailableRoom Int?     @default(0)
  totalRevenue            Int?     @default(0)
  channelRevenue          Json?    @default("{}")
  newReservations         Int?     @default(0)
  cancellations           Int?     @default(0)
  checkIns                Int?     @default(0)
  checkOuts               Int?     @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt
}

model HotelSettings {
  id                                 Int      @id
  propertyName                       String   @default("")
  tagline                            String   @default("")
  contactEmail                       String   @default("")
  contactPhone                       String   @default("")
  addressLine1                       String   @default("")
  addressLine2                       String   @default("")
  frontDeskCopy                      String   @default("")
  checkInTime                        String   @default("")
  checkOutTime                       String   @default("")
  refundApprovalThresholdMinor       Int      @default(0)
  writeOffApprovalThresholdMinor     Int      @default(0)
  cashVarianceApprovalThresholdMinor Int      @default(0)
  prearrivalEmailEnabled             Boolean  @default(false)
  prearrivalDays                     Int      @default(1)
  loyaltyEnabled                     Boolean  @default(false)
  loyaltyEarnMinorPerPoint           Int      @default(100)
  loyaltyRedeemMinorPerPoint         Int      @default(1)
  loyaltyMinimumRedemptionPoints     Int      @default(100)
  securityDepositMinor               Int      @default(0)
  depositPercent                     Int      @default(100)
  groupsEnabled                      Boolean  @default(false)
  ratePublicationRequiresApproval    Boolean  @default(true)
  timeZone                           String   @default("UTC")
  currencyCode                       String   @default("USD")
  taxRateBasisPoints                 Int      @default(1000)
  serviceFeeMinor                    Int      @default(0)
  pricingVersion                     String   @default("hotel-pricing-v2")
  storefrontAccentPreset             String   @default("brass")
  heroImagePath                      String   @default("")
  heroImageAltText                   String   @default("")
  heroImageCaption                   String   @default("")
  amenityImagePath                   String   @default("")
  amenityImageAltText                String   @default("")
  amenityImageCaption                String   @default("")
  locationImagePath                  String   @default("")
  locationImageAltText               String   @default("")
  locationImageCaption               String   @default("")
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime @default(now()) @updatedAt
}

model PaymentEvent {
  id              String          @id @default(cuid())
  replayKey       String          @unique @default("")
  providerCode    String          @default("")
  providerEventId String          @default("")
  eventType       String          @default("")
  status          String
  payloadHash     String          @default("")
  processedAt     DateTime?       @default(now())
  evidence        Json?           @default("{}")
  booking         Booking?        @relation("PaymentEvent_booking", fields: [bookingId], references: [id])
  bookingId       String?         @map("booking")
  payment         BookingPayment? @relation("PaymentEvent_payment", fields: [paymentId], references: [id])
  paymentId       String?         @map("payment")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  @@index([bookingId])
  @@index([paymentId])
}

model Folio {
  id             String       @id @default(cuid())
  folioNumber    String       @unique @default("")
  booking        Booking?     @relation("Folio_booking", onDelete: Restrict, fields: [bookingId], references: [id])
  bookingId      String?      @unique @map("booking")
  groupBlock     GroupBlock?  @relation("Folio_groupBlock", onDelete: Restrict, fields: [groupBlockId], references: [id])
  groupBlockId   String?      @unique @map("groupBlock")
  billedBookings Booking[]    @relation("Booking_billingFolio")
  status         String       @default("open")
  currencyCode   String       @default("USD")
  entries        FolioEntry[] @relation("FolioEntry_folio")
  openedAt       DateTime     @default(now())
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
}

model FolioEntry {
  id                  String      @id @default(cuid())
  folio               Folio       @relation("FolioEntry_folio", fields: [folioId], references: [id])
  folioId             String      @map("folio")
  postingKey          String      @unique @default("")
  entryType           String
  direction           String
  amountMinor         Int
  currencyCode        String      @default("")
  description         String      @default("")
  serviceDate         DateTime
  postedAt            DateTime    @default(now())
  sourceType          String
  sourceId            String      @default("")
  taxCategorySnapshot String      @default("")
  metadataSnapshot    Json?       @default("{}")
  postedBy            User?       @relation("FolioEntry_postedBy", fields: [postedById], references: [id])
  postedById          String?     @map("postedBy")
  reverses            FolioEntry? @relation("FolioEntry_reverses", fields: [reversesId], references: [id])
  reversesId          String?     @unique @map("reverses")
  reversedBy          FolioEntry? @relation("FolioEntry_reverses")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @default(now()) @updatedAt

  @@index([folioId])
  @@index([postedById])
}

model HotelAuditEvent {
  id               String   @id @default(cuid())
  eventKey         String   @unique @default("")
  requestHash      String   @default("")
  propertyKey      String   @default("")
  aggregateType    String   @default("")
  aggregateId      String   @default("")
  action           String   @default("")
  actor            User?    @relation("HotelAuditEvent_actor", fields: [actorId], references: [id])
  actorId          String?  @map("actor")
  beforeSnapshot   Json?
  afterSnapshot    Json?
  metadataSnapshot Json?    @default("{}")
  occurredAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([actorId])
  @@index([aggregateType, aggregateId, occurredAt], map: "HotelAuditEvent_aggregate_idx")
}

model HotelOutboxEvent {
  id                     String               @id @default(cuid())
  eventKey               String               @unique @default("")
  requestHash            String               @default("")
  propertyKey            String               @default("")
  topic                  String               @default("")
  aggregateType          String               @default("")
  aggregateId            String               @default("")
  payloadSnapshot        Json?                @default("{}")
  status                 String               @default("pending")
  attempts               Int                  @default(0)
  availableAt            DateTime             @default(now())
  deliveredAt            DateTime?
  lastError              String               @default("")
  leaseToken             String               @default("")
  leaseExpiresAt         DateTime?
  lastAttemptAt          DateTime?
  deadLetteredAt         DateTime?
  replayedFromEventKey   String               @default("")
  dispatchResultSnapshot Json?                @default("{}")
  maxAttempts            Int                  @default(5)
  attemptsEvidence       HotelOutboxAttempt[] @relation("HotelOutboxAttempt_outbox")
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @default(now()) @updatedAt

  @@index([status, availableAt], map: "HotelOutboxEvent_dispatch_idx")
  @@index([aggregateType, aggregateId], map: "HotelOutboxEvent_aggregate_idx")
  @@index([propertyKey, status, availableAt], map: "HotelOutboxEvent_tenant_dispatch_idx")
  @@index([propertyKey, status, leaseExpiresAt], map: "HotelOutboxEvent_lease_idx")
}

model HotelOutboxAttempt {
  id               String           @id @default(cuid())
  outbox           HotelOutboxEvent @relation("HotelOutboxAttempt_outbox", fields: [outboxId], references: [id])
  outboxId         String           @map("outbox")
  propertyKey      String           @default("")
  attemptNumber    Int
  workerId         String           @default("")
  status           String
  errorMessage     String           @default("")
  responseSnapshot Json?            @default("{}")
  startedAt        DateTime
  finishedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt

  @@unique([outboxId, attemptNumber], map: "HotelOutboxAttempt_outbox_attempt_key")
  @@index([outboxId])
  @@index([propertyKey, startedAt], map: "HotelOutboxAttempt_tenant_idx")
}

model HotelOutboxReceipt {
  id              String   @id @default(cuid())
  eventKey        String   @unique @default("")
  propertyKey     String   @default("")
  topic           String   @default("")
  aggregateType   String   @default("")
  aggregateId     String   @default("")
  credentialKeyId String   @default("")
  bodyHash        String   @default("")
  payloadSnapshot Json?    @default("{}")
  receivedAt      DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([propertyKey, receivedAt], map: "HotelOutboxReceipt_tenant_idx")
  @@index([topic, receivedAt], map: "HotelOutboxReceipt_topic_idx")
}

model HotelBusinessDate {
  id                  Int      @id
  propertyKey         String   @unique @default("")
  currentBusinessDate DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}

model NightAuditRun {
  id                 String   @id @default(cuid())
  eventKey           String   @unique @default("")
  requestHash        String   @default("")
  propertyKey        String   @default("")
  businessDate       DateTime @unique
  status             String
  dueBookingCount    Int
  postedEntryCount   Int
  existingEntryCount Int
  exceptionCount     Int
  debitMinor         Int
  startedAt          DateTime
  completedAt        DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

model GroupBlock {
  id            String                 @id @default(cuid())
  blockCode     String                 @unique @default("")
  name          String                 @default("")
  status        String
  arrivalDate   DateTime
  departureDate DateTime
  releaseDate   DateTime?
  contactName   String                 @default("")
  contactEmail  String                 @default("")
  billingType   String
  allocations   GroupBlockAllocation[] @relation("GroupBlockAllocation_groupBlock")
  bookings      Booking[]              @relation("Booking_groupBlock")
  masterFolio   Folio?                 @relation("Folio_groupBlock")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @default(now()) @updatedAt
}

model GroupBlockAllocation {
  id            String     @id @default(cuid())
  allocationKey String     @unique @default("")
  groupBlock    GroupBlock @relation("GroupBlockAllocation_groupBlock", fields: [groupBlockId], references: [id])
  groupBlockId  String     @map("groupBlock")
  roomType      RoomType   @relation("GroupBlockAllocation_roomType", fields: [roomTypeId], references: [id])
  roomTypeId    String     @map("roomType")
  roomsHeld     Int
  roomsPickedUp Int
  rateMinor     Int
  currencyCode  String     @default("")
  bookings      Booking[]  @relation("Booking_groupBlockAllocation")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt

  @@index([groupBlockId])
  @@index([roomTypeId])
}

model RefundIntent {
  id                     String          @id @default(cuid())
  intentKey              String          @unique @default("")
  requestHash            String          @default("")
  cancellationEventKey   String          @default("")
  propertyKey            String          @default("")
  booking                Booking         @relation("RefundIntent_booking", fields: [bookingId], references: [id])
  bookingId              String          @map("booking")
  sourcePayment          BookingPayment  @relation("RefundIntent_sourcePayment", fields: [sourcePaymentId], references: [id])
  sourcePaymentId        String          @map("sourcePayment")
  paymentProvider        PaymentProvider @relation("RefundIntent_paymentProvider", fields: [paymentProviderId], references: [id])
  paymentProviderId      String          @map("paymentProvider")
  amountMinor            Int
  currencyCode           String          @default("")
  reason                 String          @default("")
  actorId                String?
  status                 String          @default("pending")
  attempts               Int             @default(0)
  maxAttempts            Int             @default(8)
  availableAt            DateTime        @default(now())
  leaseToken             String          @default("")
  leaseExpiresAt         DateTime?
  lastAttemptAt          DateTime?
  completedAt            DateTime?
  deadLetteredAt         DateTime?
  providerRefundId       String?         @unique
  providerResultSnapshot Json?           @default("{}")
  lastError              String          @default("")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt

  @@index([bookingId])
  @@index([sourcePaymentId])
  @@index([paymentProviderId])
  @@index([status, availableAt], map: "RefundIntent_dispatch_idx")
  @@index([bookingId, status], map: "RefundIntent_booking_status_idx")
  @@index([sourcePaymentId, status], map: "RefundIntent_source_status_idx")
}

model HotelSeedRecord {
  id          String   @id @default(cuid())
  seedKey     String   @unique @default("")
  section     String   @default("")
  entityId    String   @default("")
  contentHash String   @default("")
  seedVersion String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([section, entityId], map: "HotelSeedRecord_entity_idx")
}

model HotelAbuseBucket {
  id              String   @id @default(cuid())
  bucketKey       String   @unique @default("")
  count           Int      @default(0)
  windowStartedAt DateTime
  expiresAt       DateTime

  @@index([expiresAt], map: "HotelAbuseBucket_expiry_idx")
}

model HotelWorkerLease {
  id          String   @id @default(cuid())
  leaseKey    String   @unique @default("")
  ownerId     String   @default("")
  expiresAt   DateTime
  heartbeatAt DateTime
}

model BookingModificationRequest {
  id                    String    @id @default(cuid())
  requestKey            String    @unique @default("")
  booking               Booking   @relation("BookingModificationRequest_booking", fields: [bookingId], references: [id])
  bookingId             String    @map("booking")
  requestedCheckInDate  DateTime?
  requestedCheckOutDate DateTime?
  guestMessage          String    @default("")
  requestedByEmailHash  String    @default("")
  status                String    @default("pending")
  resolutionKey         String?   @unique
  resolutionRequestHash String    @default("")
  resolvedBy            User?     @relation("BookingModificationRequest_resolvedBy", fields: [resolvedById], references: [id])
  resolvedById          String?   @map("resolvedBy")
  resolvedAt            DateTime?
  staffNote             String    @default("")
  resultSnapshot        Json?     @default("{}")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@index([bookingId])
  @@index([resolvedById])
  @@index([bookingId, status, createdAt], map: "BookingModificationRequest_booking_status_created_idx")
}
