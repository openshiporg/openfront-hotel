  totalAmountMinor                    Int                          @default(0)
  depositAmountMinor                  Int                          @default(0)
  balanceDueMinor                     Int                          @default(0)
  currencyCode                        String                       @default("USD")
  roomRate                            Float?
  taxAmount                           Float?                       @default(0)
  feesAmount                          Float?                       @default(0)
  totalAmount                         Float?
  depositAmount                       Float?                       @default(0)
  balanceDue                          Float?
  ratePlan                            RatePlan?                    @relation("Booking_ratePlan", fields: [ratePlanId], references: [id])
  ratePlanId                          String?                      @map("ratePlan")
  pricingVersion                      String                       @default("legacy-v1")
  pricingRevision                     Int                          @default(1)
  pricingSnapshot                     Json?                        @default("{}")
  status                              String?                      @default("pending")
  paymentStatus                       String?                      @default("unpaid")
  source                              String?                      @default("direct")
  specialRequests                     String                       @default("")
  internalNotes                       String                       @default("")
  guestAccessTokenHash                String                       @default("")
  guestAccessTokenIssuedAt            DateTime?
  roomAssignments                     RoomAssignment[]             @relation("RoomAssignment_booking")
  guestProfile                        Guest                        @relation("Booking_guestProfile", fields: [guestProfileId], references: [id])
  guestProfileId                      String                       @map("guestProfile")
  guest                               User?                        @relation("Booking_guest", fields: [guestId], references: [id])
  guestId                             String?                      @map("guest")
  folio                               Folio?                       @relation("Folio_booking")
  billingFolio                        Folio?                       @relation("Booking_billingFolio", onDelete: Restrict, fields: [billingFolioId], references: [id])
  billingFolioId                      String?                      @map("billingFolio")
  groupBlock                          GroupBlock?                  @relation("Booking_groupBlock", onDelete: Restrict, fields: [groupBlockId], references: [id])
  groupBlockId                        String?                      @map("groupBlock")
  groupBlockAllocation                GroupBlockAllocation?        @relation("Booking_groupBlockAllocation", onDelete: Restrict, fields: [groupBlockAllocationId], references: [id])
  groupBlockAllocationId              String?                      @map("groupBlockAllocation")
  lineItems                           ReservationLineItem[]        @relation("ReservationLineItem_reservation")
  payments                            BookingPayment[]             @relation("BookingPayment_booking")
  paymentSessions                     BookingPaymentSession[]      @relation("BookingPaymentSession_booking")
  paymentEvents                       PaymentEvent[]               @relation("PaymentEvent_booking")
  refundIntents                       RefundIntent[]               @relation("RefundIntent_booking")
  modificationRequests                BookingModificationRequest[] @relation("BookingModificationRequest_booking")
  holdExpiresAt                       DateTime?
  confirmedAt                         DateTime?
  checkedInAt                         DateTime?
  checkedOutAt                        DateTime?
  cancelledAt                         DateTime?
  createdAt                           DateTime                     @default(now())
  updatedAt                           DateTime                     @default(now()) @updatedAt
  from_LoyaltyTransaction_booking     LoyaltyTransaction[]         @relation("LoyaltyTransaction_booking")
  from_ChannelReservation_reservation ChannelReservation[]         @relation("ChannelReservation_reservation")

  @@index([ratePlanId])
  @@index([guestAccessTokenHash])
  @@index([guestProfileId])
  @@index([guestId])
  @@index([billingFolioId])
  @@index([groupBlockId])
  @@index([groupBlockAllocationId])
  @@index([status, checkInDate, checkOutDate], map: "Booking_status_stay_idx")
  @@index([checkOutDate, status], map: "Booking_departure_status_idx")
